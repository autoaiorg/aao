# ==============================================================================
# AAO — Plantilla Canónica de Configuración de Entorno (NO USAR EN PRODUCCIÓN DIRECTA)
# ==============================================================================
# Copie este archivo a .env.local para desarrollo local interactivo.
# NUNCA guarde credenciales reales ni suba .env.local / .env.test a Git.
# En producción, systemd carga variables desde archivos protegidos (0600) bajo /etc/aao/.
# Las variables exportadas en el entorno del proceso siempre prevalecen sobre dotenv.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO GENERAL DEL RUNTIME
# ------------------------------------------------------------------------------
# AAO_ENV: Entorno de ejecución ('development', 'test', 'production').
# Componente: src/aao/environment_settings.py
# Obligatorio: No (default: development). Sensibilidad: Baja.
AAO_ENV=development

# AAO_ENV_FILE: Nombre del archivo dotenv permitido (solo en dev/test).
# Componente: src/aao/environment_settings.py
# Obligatorio: No (default: .env.local). Sensibilidad: Baja.
AAO_ENV_FILE=.env.local

# ------------------------------------------------------------------------------
# 2. POSTGRESQL (DATASTORE CANÓNICO DEL PRODUCTO)
# ------------------------------------------------------------------------------
# AAO_POSTGRES_URL: DSN de conexión PostgreSQL para la API y workers.
# Componente: src/aao/postgresql_connection.py, src/aao/migrator.py
# Obligatorio: Sí para modo PostgreSQL. Sensibilidad: Alta (contiene credenciales de DB).
# Consecuencia ausencia: Fallo 503 en /ready y fallo en migraciones/operaciones.
AAO_POSTGRES_URL=postgresql://aao_app:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5432/aao_prod

# AAO_DEV_POSTGRES_PASSWORD: Password de desarrollo utilizada en compose.dev.yaml.
# Componente: compose.dev.yaml
# Obligatorio: Solo en desarrollo con Docker Compose. Sensibilidad: Alta.
AAO_DEV_POSTGRES_PASSWORD=CHANGE_ME_DEV_POSTGRES_PASSWORD

# AAO_TEST_POSTGRES_URL: DSN para la base de datos desechable de pruebas automatizadas.
# Componente: tests/, .github/workflows/ci.yml
# Obligatorio: Sí para ejecutar suites de integración. Sensibilidad: Media.
AAO_TEST_POSTGRES_URL=postgresql://aao_dev:CHANGE_ME_DEV_POSTGRES_PASSWORD@127.0.0.1:54329/aao_test

# AAO_TEST_DB_DISPOSABLE: Salvaguarda explícita contra ejecución de tests en DB real.
# Componente: src/aao/environment_settings.py, tests/
# Obligatorio: Sí para pytest ('yes'). Sensibilidad: Baja.
AAO_TEST_DB_DISPOSABLE=no

# ------------------------------------------------------------------------------
# 3. AUTENTICACIÓN Y SEGURIDAD DEL CEO Y SPA
# ------------------------------------------------------------------------------
# AAO_CEO_TOKEN: Token Bearer secreto del CEO para loopback.
# Componente: src/aao/work_management_api.py, scripts/rotate_local_ceo_token.py
# Obligatorio: Sí para endpoints protegidos por el CEO. Sensibilidad: Crítica.
# Longitud mínima: 43 caracteres urlsafe.
AAO_CEO_TOKEN=CHANGE_ME_MIN_43_CHARS_RANDOM_CEO_BEARER_TOKEN

# AAO_CEO_SESSION_ALLOWED_ORIGINS: Orígenes autorizados para sesiones de navegador (CORS/Cookie).
# Componente: src/aao/work_management_api.py
# Obligatorio: No (default: http://127.0.0.1:5173,http://localhost:5173). Sensibilidad: Media.
AAO_CEO_SESSION_ALLOWED_ORIGINS=http://127.0.0.1:8001,http://127.0.0.1:5173

# AAO_CEO_USER: Cuenta Linux local del CEO (utilizada en preflight y verificación).
# Componente: scripts/verify_trust_root_host.py, scripts/identity_separation.sh
# Obligatorio: No (default: usuario actual). Sensibilidad: Media.
AAO_CEO_USER=alessbarb

# ------------------------------------------------------------------------------
# 4. EXPOSICIÓN DE RED Y FRONTEND CONTROL CENTER
# ------------------------------------------------------------------------------
# AAO_API: URL base interna para clientes de scripts y workers.
# Componente: scripts/self_development_cycle.py, scripts/run_self_development_worker.py
# Obligatorio: No (default: http://127.0.0.1:8001). Sensibilidad: Baja.
AAO_API=http://127.0.0.1:8001

# AAO_API_TARGET: Target proxy utilizado durante desarrollo de frontend con Vite.
# Componente: frontend/app/vite.config.ts
# Obligatorio: No (default: http://127.0.0.1:8001). Sensibilidad: Baja.
AAO_API_TARGET=http://127.0.0.1:8001

# AAO_STATIC_DIR: Directorio absoluto donde se ubican los activos compilados del frontend.
# Componente: src/aao/work_management_api.py
# Obligatorio: No (default: frontend/app/dist). Sensibilidad: Baja.
AAO_STATIC_DIR=/opt/aao/frontend/dist

# ------------------------------------------------------------------------------
# 5. AISLAMIENTO Y REPOSITORIOS DE TRABAJO
# ------------------------------------------------------------------------------
# AAO_SANDBOX_QUEUE_ENABLED: Habilita el aislamiento por cola mediante bubblewrap (bwrap).
# Componente: src/aao/environment_settings.py, src/aao/work_management_api.py
# Obligatorio: No (default: false). Sensibilidad: Media.
AAO_SANDBOX_QUEUE_ENABLED=false

# AAO_SELF_DEV_REPOSITORY: Repositorio canónico verificado para Self Development.
# Componente: src/aao/work_management_api.py, scripts/rotate_local_ceo_token.py
# Obligatorio: No (default: directorio raíz del repositorio). Sensibilidad: Media.
AAO_SELF_DEV_REPOSITORY=/opt/aao/repo

# AAO_CANDIDATE_REPOSITORY: Directorio de trabajo aislado donde los agentes generan candidatos.
# Componente: src/aao/agent_runner.py, src/aao/pr_publisher.py
# Obligatorio: No (default: directorio temporal privado). Sensibilidad: Media.
AAO_CANDIDATE_REPOSITORY=/var/lib/aao/candidates

# AAO_ARCHIVE_DIR: Directorio seguro donde se archivan evidencias y copias de identidad.
# Componente: scripts/identity_separation.sh, src/aao/backup.py
# Obligatorio: No (default: /var/backups/aao o /root). Sensibilidad: Alta.
AAO_ARCHIVE_DIR=/var/backups/aao

# ------------------------------------------------------------------------------
# 6. CONFIGURACIÓN DEL RUNNER DE AGENTES Y MODELOS
# ------------------------------------------------------------------------------
# AAO_AGENT_PROVIDER: Proveedor del agente de ejecución ('fixture', 'codex', etc.).
# Componente: src/aao/agent_runner.py
# Obligatorio: No (default: 'fixture'). Sensibilidad: Media.
AAO_AGENT_PROVIDER=fixture

# AAO_AGENT_BACKEND: Backend tecnológico del runner ('fixture', 'codex', etc.).
# Componente: src/aao/agent_runner.py
AAO_AGENT_BACKEND=fixture

# AAO_AGENT_CODEX_HOME: Ruta de configuración para el agente Codex.
# Componente: src/aao/agent_runner.py
AAO_AGENT_CODEX_HOME=/home/aao-impl-codex/.codex

# AAO_AGENT_CODEX_MODEL: Modelo fijado para tareas Codex (ej. 'gpt-6-luna').
# Componente: src/aao/agent_runner.py
AAO_AGENT_CODEX_MODEL=gpt-6-luna

# AAO_AGENT_MAX_ATTEMPTS: Límite de reintentos automáticos para tareas fallidas.
# Componente: src/aao/agent_runner.py
AAO_AGENT_MAX_ATTEMPTS=3

# AAO_AGENT_DAILY_BUDGET_USD: Presupuesto diario máximo de ejecución en USD.
# Componente: src/aao/agent_runner.py
AAO_AGENT_DAILY_BUDGET_USD=50.0

# AAO_AGENT_QUEUE_ENABLED: Activa el procesamiento en segundo plano de tareas.
# Componente: src/aao/agent_runner.py
AAO_AGENT_QUEUE_ENABLED=false

# ------------------------------------------------------------------------------
# 7. PROVEEDORES DE CONVERSACIÓN Y RECUPERACIÓN DE TURNOS
# ------------------------------------------------------------------------------
# AAO_CONVERSATION_PROVIDER: Proveedor para conversación CEO ('dummy', 'gemini', 'openai').
# Componente: src/aao/conversation_provider.py
AAO_CONVERSATION_PROVIDER=dummy

# AAO_CONVERSATION_MODEL: Modelo utilizado para turnos de conversación.
# Componente: src/aao/conversation_provider.py
AAO_CONVERSATION_MODEL=gemini-2.0-flash

# AAO_CONVERSATION_API_KEY: Clave de API para el proveedor de conversación.
# Componente: src/aao/conversation_provider.py
# Obligatorio: Solo si el proveedor requiere API key externa. Sensibilidad: Crítica.
# AAO_CONVERSATION_API_KEY=CHANGE_ME_SECRET_KEY

# AAO_CONVERSATION_API_URL: Endpoint personalizado del proveedor de conversación.
# Componente: src/aao/conversation_provider.py
# AAO_CONVERSATION_API_URL=https://api.example.com

# AAO_CONVERSATION_RECOVERY_ENABLED: Habilita el servicio de recuperación de turnos expirados.
# Componente: src/aao/conversation_turn_recovery.py
AAO_CONVERSATION_RECOVERY_ENABLED=false

# ------------------------------------------------------------------------------
# 8. PARÁMETROS HEREDADOS DEL PROTOTIPO SQLITE (OBSOLETOS EN POSTGRESQL)
# ------------------------------------------------------------------------------
# No son aceptados por el backend PostgreSQL de producción (aao.work_management_api).
# Se documentan para prevenir confusión con código heredado de sqlite_api.
AAO_WORK_TOKEN=LEGACY_SQLITE_TOKEN_ONLY
AAO_REVIEW_TOKEN=LEGACY_SQLITE_TOKEN_ONLY
AAO_DB_PATH=./data/aao.sqlite3
