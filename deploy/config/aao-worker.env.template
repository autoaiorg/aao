# Production environment for aao-worker-self-dev.service
# Permissions: 0600 root:aao-impl-ag under /etc/aao/aao-worker.env
AAO_ENV=production
AAO_API=http://127.0.0.1:8001
AAO_SELF_DEV_REPOSITORY=/opt/aao/repo
AAO_AGENT_PROVIDER=fixture
AAO_AGENT_BACKEND=fixture
# Required before AAO_AGENT_PROVIDER=codex; must be a positive, finite USD amount.
# The Codex backend fails closed if unset, empty, non-numeric, zero, negative, NaN or infinity.
# Example only; set the CEO-approved limit explicitly when activating Codex:
# AAO_AGENT_DAILY_BUDGET_USD=5.00
# Set only after the CEO-confirmed mandate and AGENT grant are provisioned.
# These identifiers are configuration, not credentials. Leave unset otherwise.
AAO_WORKER_PROJECT_ID=
AAO_WORKER_PRINCIPAL_ID=
