[Unit]
Description=AAO Self-Development Codex worker for project %i
ConditionPathExists=/etc/aao/selfdev-codex-worker.env
ConditionPathExists=%t/aao-self-development-agent.token
After=default.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/aao/selfdev-codex-worker.env
Environment=XDG_RUNTIME_DIR=%t
Environment=XDG_DATA_HOME=%h/.local/share
Environment=AAO_ENV=production
Environment=AAO_API_BASE_URL=http://127.0.0.1:8001
WorkingDirectory=/srv/aao/frozen/aao-pm/tree
ExecStart=/srv/aao/frozen/aao-pm/venv/bin/python -I -c "import sys; sys.path.insert(0, '/srv/aao/frozen/aao-pm/tree'); from scripts.run_self_development_worker import main; raise SystemExit(main())" --project-id %i --watch
Restart=on-failure
RestartSec=30s
TimeoutStopSec=35m
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=%h/.local/share/aao

[Install]
WantedBy=default.target
