[Unit]
Description=AAO Self-Development Codex worker for project %i
ConditionPathExists=/etc/aao/selfdev-codex-worker.env
ConditionPathIsDirectory=%h/.config/aao/workload-tls
ConditionPathExists=%h/.config/aao/workload-tls/client-cert.pem
ConditionPathExists=%h/.config/aao/workload-tls/client-key.pem
ConditionPathExists=%h/.config/aao/workload-tls/server-ca.pem
After=default.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/aao/selfdev-codex-worker.env
# The EnvironmentFile must set AAO_AGENT_DAILY_BUDGET_USD to a positive finite
# USD amount; the Codex backend fails closed when it is absent or invalid.
Environment=XDG_RUNTIME_DIR=%t
Environment=XDG_DATA_HOME=%h/.local/share
# Never use the cycle bearer-token file in production. The verified client
# certificate is the workload identity; systemd supplies it privately.
LoadCredential=client-cert:%h/.config/aao/workload-tls/client-cert.pem
LoadCredential=client-key:%h/.config/aao/workload-tls/client-key.pem
LoadCredential=server-ca:%h/.config/aao/workload-tls/server-ca.pem
WorkingDirectory=/srv/aao/frozen/aao-pm/tree
ExecStart=/usr/bin/env AAO_ENV=production AAO_API_BASE_URL=https://127.0.0.1:8443 /srv/aao/frozen/aao-pm/venv/bin/python -I -c "import sys; sys.path.insert(0, '/srv/aao/frozen/aao-pm/tree'); from scripts.run_self_development_worker import main; raise SystemExit(main())" --project-id %i --watch
Restart=on-failure
RestartSec=30s
TimeoutStopSec=35m
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=read-only
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=%h/.local/share/aao

[Install]
WantedBy=default.target
